{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "webservices.rest": ">=2.44.0",
    "chartsearchai": ">=1.0.0-SNAPSHOT"
  },
  "extensions": [
    {
      "name": "ai-search-button",
      "component": "aiSearchButton",
      "slot": "patient-banner-tags-slot",
      "privilege": "AI Query Patient Data",
      "order": 100
    },
    {
      "name": "chartsearch-query-results-view",
      "component": "chartSearchQueryResultsView",
      "slot": "omnibar-query-results-slot",
      "privileges": ["AI Query Patient Data"],
      "meta": {
        "scopes": ["patient"],
        "order": 100,
        "contract": 1,
        "skipIdentifierQueries": true,
        "asksModel": "ChartSearch",
        "commandAsksModel": true,
        "command": { "id": "ask", "aliases": ["ask", "question"] }
      }
    },
    {
      "name": "chartsearch-model-provider",
      "component": "chartSearchModelProvider",
      "slot": "omnibar-providers-slot",
      "privileges": ["AI Query Patient Data"],
      "meta": {
        "lane": "navigate",
        "scopes": ["global", "patient"],
        "order": 20,
        "defaultInChart": true,
        "contract": 1,
        "skipIdentifierQueries": true,
        "command": { "id": "model", "aliases": ["model", "models", "profile"] }
      }
    }
  ],
  "workspaces2": [
    {
      "name": "ai-chat-workspace",
      "component": "aiChatWorkspace",
      "window": "ai-chat"
    }
  ],
  "workspaceWindows2": [
    {
      "name": "ai-chat",
      "group": "patient-chart",
      "icon": "aiChatActionButton",
      "width": "wider",
      "order": 5
    }
  ]
}
